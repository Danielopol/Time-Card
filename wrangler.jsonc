// Cloudflare Workers config: the site is static files only, served from dist/.
{
  "name": "time-card",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Branch builds run `wrangler preview`, which refuses to run without this block. It can stay empty.
  "previews": {}
}
