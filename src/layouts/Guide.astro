---
import Base from './Base.astro';
import Faq from '../components/Faq.astro';
import ToolGrid from '../components/ToolGrid.astro';
import { formatDate, getGuide, guidePath } from '../guides';
import { SITE } from '../site';

interface Props {
  slug: string;
  /** One or two sentences under the heading. */
  lede: string;
  /** The law and official pages the guide relies on. */
  sources: { label: string; url: string }[];
  faq?: { q: string; a: string }[];
  /** Tool pages to link at the bottom. */
  tools?: string[];
}

const { slug, lede, sources, faq, tools } = Astro.props;
const guide = getGuide(slug);
const url = new URL(guidePath(slug), SITE.url).href;

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.description,
  datePublished: guide.published,
  dateModified: guide.updated,
  mainEntityOfPage: url,
  ...(SITE.owner ? { author: { '@type': 'Person', name: SITE.owner } } : {}),
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Guides', item: new URL('/guides/', SITE.url).href },
    { '@type': 'ListItem', position: 2, name: guide.title, item: url },
  ],
};
const json = (value: object) => JSON.stringify(value).replace(/</g, '\\u003c');
---

<Base title={guide.title} description={guide.description}>
  <nav class="crumbs no-print" aria-label="Breadcrumb">
    <a href="/guides/">Guides</a> <span aria-hidden="true">/</span> <span>{guide.title}</span>
  </nav>
  <article class="prose">
    <h1>{guide.title}</h1>
    <p class="lede">{lede}</p>
    <p class="meta">
      {SITE.owner && <>By {SITE.owner} · </>}Updated {formatDate(guide.updated)}
    </p>
    <slot />
    <section class="sources">
      <h2>Sources</h2>
      <ul>
        {
          sources.map((source) => (
            <li>
              <a href={source.url} rel="noopener">{source.label}</a>
            </li>
          ))
        }
      </ul>
      <p class="hint">
        This guide explains how the rules work in general. It is not legal or payroll advice, and rules change. For a decision that matters, check with
        your employer, your state labor office or a payroll professional.
      </p>
    </section>
  </article>
  {faq && <Faq items={faq} />}
  <ToolGrid hrefs={tools} heading="Related tools" />
  <script type="application/ld+json" set:html={json(article)} />
  <script type="application/ld+json" set:html={json(crumbs)} />
</Base>
