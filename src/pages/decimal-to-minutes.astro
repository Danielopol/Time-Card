---
import Base from '../layouts/Base.astro';
import Converter from '../components/Converter.tsx';
import Faq from '../components/Faq.astro';
import ToolGrid from '../components/ToolGrid.astro';
import { decimalHoursToMinutes, formatHM } from '../engine/time';

const common = [0.1, 0.2, 0.25, 0.3, 0.4, 0.5, 0.6, 0.7, 0.75, 0.8, 0.9, 1, 1.25, 1.5, 1.75, 2.5].map((hours) => ({
  hours: hours.toFixed(2),
  minutes: decimalHoursToMinutes(hours),
}));

const faq = [
  {
    q: 'What is 0.75 hours in minutes?',
    a: '0.75 hours is 45 minutes, because 0.75 times 60 is 45.',
  },
  {
    q: 'What is 1.5 hours in hours and minutes?',
    a: '1.5 hours is 1 hour 30 minutes. The whole number is the hours, and 0.5 times 60 is 30 minutes.',
  },
  {
    q: 'How many minutes is 0.1 hours?',
    a: '0.1 hours is 6 minutes, because 0.1 times 60 is 6. Each tenth of an hour is 6 minutes, so 0.2 is 12 minutes and 0.3 is 18 minutes.',
  },
  {
    q: 'How do I convert 7.25 hours to hours and minutes?',
    a: 'Keep the 7 as hours and multiply 0.25 by 60 to get 15 minutes. 7.25 hours is 7 hours 15 minutes.',
  },
  {
    q: 'Is 7.50 hours the same as 7:50?',
    a: 'No. 7.50 hours is 7 hours 30 minutes. A time of 7:50 is 7 hours 50 minutes, which is 7.83 decimal hours.',
  },
  {
    q: 'Why is my answer one minute off?',
    a: 'Decimal hours are usually rounded to two places, so some detail is lost. 20 minutes is 0.3333 hours, which is written as 0.33. Converting 0.33 back gives 19.8 minutes, which this converter rounds to 20.',
  },
  {
    q: 'Why does my pay stub show hours as a decimal?',
    a: 'Payroll multiplies hours by your pay rate, which only works with decimal hours. A pay stub showing 38.75 hours means 38 hours 45 minutes.',
  },
];
---

<Base
  title="Decimal to Minutes Converter: Decimal Hours to Hours and Minutes"
  description="Convert decimal hours to hours and minutes. Multiply the decimal part by 60: 0.75 hours is 45 minutes."
  appName="Decimal Hours to Minutes Converter"
>
  <h1>Decimal Hours to Minutes</h1>
  <p class="lede">Convert decimal hours back to hours and minutes. Multiply the decimal part by 60: 0.75 hours is 0.75 × 60 = 45 minutes.</p>
  <Converter direction="toMinutes" client:load />

  <div class="prose">
    <section>
      <h2>How to convert decimal hours to minutes</h2>
      <ol>
        <li>The whole number is the hours.</li>
        <li>Multiply the decimal part by 60 to get the minutes.</li>
        <li>Round to the nearest whole minute.</li>
      </ol>
      <p>
        For 7.8 hours: the hours are 7, and 0.8 × 60 = 48, so the time is 7 hours 48 minutes. For a decimal under one hour, the answer is only minutes:
        0.25 hours is 15 minutes.
      </p>
      <p>
        A decimal is not the same as a clock time. 7.50 hours is 7 hours 30 minutes, not 7:50.
      </p>
    </section>

    <section>
      <h2>Common decimal hours in minutes</h2>
      <table class="chart">
        <thead>
          <tr>
            <th scope="col">Decimal hours</th>
            <th scope="col">Hours and minutes</th>
            <th scope="col">Total minutes</th>
          </tr>
        </thead>
        <tbody>
          {
            common.map((row) => (
              <tr>
                <th scope="row">{row.hours}</th>
                <td>{row.hours} hours = {formatHM(row.minutes)}</td>
                <td>{row.minutes}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p>
        Going the other way? The <a href="/minutes-to-decimal/">minutes to decimal converter</a> has a printable chart for every minute from 1 to 60. To
        total a week of hours, use the <a href="/">time card calculator</a>.
      </p>
    </section>
  </div>

  <Faq items={faq} />
  <ToolGrid />
</Base>
