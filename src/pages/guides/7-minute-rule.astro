---
import Guide from '../../layouts/Guide.astro';
import { formatMoney } from '../../engine/money';
import type { RoundingIncrement } from '../../engine/round';
import { dayWorkedMinutes } from '../../engine/timecard';
import { formatHM, parseTime } from '../../engine/time';

// Every figure on this page is worked out by the same code as the time card, so the figures cannot drift.
const t = (s: string) => parseTime(s)!;

// Two days with no lunch, rounded to the quarter hour.
const days = [
  { label: 'Monday', in: '7:53 AM', out: '5:07 PM' },
  { label: 'Tuesday', in: '8:07 AM', out: '4:53 PM' },
].map((d) => {
  const punches = { in: t(d.in), lunchOut: null, lunchIn: null, out: t(d.out) };
  const actual = dayWorkedMinutes(punches, 0);
  const rounded = dayWorkedMinutes(punches, 15);
  return { ...d, actual, rounded, diff: rounded - actual };
});
if (days[0].diff !== -14 || days[1].diff !== 14) throw new Error('The 7-minute rule example no longer matches the text.');
const signedMinutes = (m: number) => (m > 0 ? `+${m}` : m < 0 ? `−${Math.abs(m)}` : '0') + ' minutes';

// Three weekly patterns, each run through every rounding system. Lunch is 12:00 to 12:30 every day.
const lunch = { lunchOut: t('12:00 PM'), lunchIn: t('12:30 PM') };
const patterns = [
  {
    title: 'Mixed: sometimes early, sometimes late',
    days: [['7:53 AM', '5:07 PM'], ['8:07 AM', '4:53 PM'], ['7:58 AM', '5:02 PM'], ['8:02 AM', '4:58 PM'], ['8:00 AM', '5:00 PM']],
  },
  { title: 'In 5 minutes early (7:55), out on the dot (5:00)', days: Array(5).fill(['7:55 AM', '5:00 PM']) },
  { title: 'In on time (8:00), out 6 minutes late (5:06)', days: Array(5).fill(['8:00 AM', '5:06 PM']) },
];
const increments: { value: RoundingIncrement; label: string }[] = [
  { value: 0, label: 'Exact' },
  { value: 5, label: 'Nearest 5 minutes' },
  { value: 6, label: 'Nearest 6 minutes' },
  { value: 15, label: 'Nearest 15 minutes' },
];
const week = (days: string[][], rounding: RoundingIncrement) =>
  days.reduce((sum, [inn, out]) => sum + dayWorkedMinutes({ in: t(inn), ...lunch, out: t(out) }, rounding), 0);
const table = patterns.map((p) => {
  const actual = week(p.days, 0);
  return { ...p, diffs: increments.map((inc) => week(p.days, inc.value) - actual) };
});
const expected = [
  [0, 0, 0, 0],
  [0, 0, 5, -25],
  [0, -5, 0, -30],
];
if (JSON.stringify(table.map((r) => r.diffs)) !== JSON.stringify(expected)) throw new Error('The rounding examples no longer match the text.');

// The third pattern under quarter-hour rounding, over 50 working weeks at $20 an hour.
const lostMinutes = -table[2].diffs[3] * 50;
const lostCents = Math.round((lostMinutes * 2000) / 60);
if (lostMinutes !== 1500 || lostCents !== 50000) throw new Error('The yearly rounding figure no longer matches the text.');

const signed = (m: number) => (m > 0 ? `+${m}` : m < 0 ? `−${Math.abs(m)}` : '0');

const faq = [
  {
    q: 'Is the 7-minute rule legal?',
    a: 'Federal rules accept rounding clock times to the nearest quarter hour, as long as it does not, over time, leave employees unpaid for time they worked. In California a court of appeal has allowed neutral rounding of work time, but rounding is not allowed for meal periods. State rules and your employer\'s policy can differ, so ask your employer or your state labor office if you are unsure.',
  },
  {
    q: 'Is the 7-minute rule applied to clocking in and clocking out?',
    a: 'Usually yes. Each punch is rounded on its own, so the start time and the end time can each move by up to 7 minutes.',
  },
  {
    q: 'Which rounding systems does the federal rule allow?',
    a: 'The nearest 5 minutes, the nearest tenth of an hour (6 minutes) and the nearest quarter hour (15 minutes, the 7-minute rule).',
  },
  {
    q: 'How do I know if rounding is costing me time?',
    a: 'Record your real clock times for a few weeks. Enter them in the time card calculator with Rounding set to exact minutes, note the total, then switch Rounding to your employer\'s system and compare. A difference that is always negative means the rounding is working against you.',
  },
  {
    q: 'Can my employer round down every time?',
    a: 'Courts have treated rounding policies as a problem when they systematically underpay employees, for example by only ever rounding down. Ask payroll for the written policy and show them your own record of your times. If you are still concerned, your state labor office can explain the rules.',
  },
  {
    q: 'Can my lunch break be rounded?',
    a: 'In California, no: the California Supreme Court held in 2021 that meal period punches cannot be rounded. Elsewhere, ask your employer for the policy.',
  },
  {
    q: 'What is 7 minutes as a decimal?',
    a: '7 minutes is 0.12 hours (7 divided by 60 is 0.1167). Rounded to the quarter hour, the possible values are 0.00, 0.25, 0.50, 0.75 and 1.00 of an hour.',
  },
  {
    q: 'Is rounding required?',
    a: 'No. Federal rules permit it, but many employers pay for the exact minutes worked.',
  },
];
---

<Guide
  slug="7-minute-rule"
  lede="The 7-minute rule rounds clock-in and clock-out times to the nearest quarter hour. Rounding is legal when it is neutral, but a rule that is fair on paper can still lose you time in practice. Here is how it works, what the law says and how to test your own pay."
  sources={[
    { label: '29 CFR 785.48: Time clocks and rounding', url: 'https://www.law.cornell.edu/cfr/text/29/785.48' },
    {
      label: 'Donohue v. AMN Services, LLC, California Supreme Court, No. S253677 (February 25, 2021)',
      url: 'https://supreme.courts.ca.gov/sites/default/files/supremecourt/default/2022-08/S253677.pdf',
    },
  ]}
  faq={faq}
  tools={['/', '/minutes-to-decimal/', '/hours-calculator/']}
>
  <section>
    <h2>How the 7-minute rule works</h2>
    <p>
      Each clock punch is rounded to the nearest 15 minutes. A punch up to 7 minutes past a quarter hour rounds back to it, and a punch 8 minutes or
      more past rounds forward to the next one. That is where the name comes from.
    </p>
    <table class="chart">
      <thead>
        <tr>
          <th scope="col">Minutes past the hour</th>
          <th scope="col">Rounds to</th>
        </tr>
      </thead>
      <tbody>
        <tr><th scope="row">:00 to :07</th><td>:00</td></tr>
        <tr><th scope="row">:08 to :22</th><td>:15</td></tr>
        <tr><th scope="row">:23 to :37</th><td>:30</td></tr>
        <tr><th scope="row">:38 to :52</th><td>:45</td></tr>
        <tr><th scope="row">:53 to :59</th><td>The next hour, at :00</td></tr>
      </tbody>
    </table>
    <p>So 8:07 AM becomes 8:00 AM, 8:08 AM becomes 8:15 AM, and 4:53 PM becomes 5:00 PM.</p>
  </section>

  <section>
    <h2>Rounding works both ways</h2>
    <p>
      Rounding can help or hurt on any one day. Arriving early and clocking in at 7:53 rounds up to 8:00, which costs the employee 7 minutes. Arriving
      late and clocking in at 8:07 rounds down to 8:00, which gives the employee 7 minutes. The same happens when clocking out.
    </p>
    <table class="chart">
      <thead>
        <tr>
          <th scope="col">Day</th>
          <th scope="col">Clocked in and out</th>
          <th scope="col">Actual time</th>
          <th scope="col">Paid time (rounded)</th>
          <th scope="col">Difference</th>
        </tr>
      </thead>
      <tbody>
        {
          days.map((d) => (
            <tr>
              <th scope="row">{d.label}</th>
              <td>{d.in} to {d.out}</td>
              <td>{formatHM(d.actual)}</td>
              <td>{formatHM(d.rounded)}</td>
              <td>{signedMinutes(d.diff)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p>Over the two days the differences cancel out. That is the idea behind rounding: it should average out to the time actually worked.</p>
  </section>

  <section>
    <h2>Is time clock rounding legal?</h2>
    <p>
      The Department of Labor's rule on rounding, 29 CFR 785.48(b), accepts recording starting and stopping times to the nearest 5 minutes, to the
      nearest tenth of an hour or to the nearest quarter of an hour. It sets one condition: the practice must not, over a period of time, leave
      employees unpaid for all the time they actually worked.
    </p>
    <p>
      The regulation does not use the name "7-minute rule". That is simply the usual way of describing rounding to the nearest quarter hour.
    </p>
    <p>
      So the test is the pattern, not the rule. A policy is neutral when it rounds in the employee's favour about as often as against. Courts have
      treated a policy as a problem when it systematically underpays employees. A policy that only ever rounds down is the standard example.
    </p>
  </section>

  <section>
    <h2>Rounding in California</h2>
    <p>
      A California court of appeal decided in 2012 (<em>See's Candy Shops v. Superior Court</em>) that an employer may use rounded time punches to
      work out regular and overtime wages if the policy is neutral on its face and in how it is applied.
    </p>
    <p>
      Meal periods are different. In <em>Donohue v. AMN Services</em> (2021), the California Supreme Court held that employers cannot round time
      punches in the meal period context, because the meal period rules are meant to prevent even minor infringements. A California employer cannot
      round a 28-minute meal break up to 30. See the guide to <a href="/guides/california-meal-and-rest-breaks/">California meal and rest breaks</a>.
    </p>
  </section>

  <section>
    <h2>Is rounding costing you?</h2>
    <p>
      Neutral rounding averages out, but a steady habit can lose time under one system and none under another. The table shows three weekly patterns
      of clock times, each run through the three systems the federal rule names. Each figure is how many minutes the week's paid time differs from
      the time actually worked. A minus sign means the employee is paid for less time than they worked.
    </p>
    <table class="chart">
      <thead>
        <tr>
          <th scope="col">Pattern (five days a week)</th>
          {increments.map((inc) => <th scope="col" class="num">{inc.label}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          table.map((row) => (
            <tr>
              <th scope="row">{row.title}</th>
              {row.diffs.map((d) => <td class="num">{signed(d)}</td>)}
            </tr>
          ))
        }
      </tbody>
    </table>
    <p>
      The mixed pattern comes out even under every system, which is what neutral rounding looks like. The other two are steady habits, and the result
      depends on the system. Arriving 5 minutes early costs nothing under 5-minute rounding but 25 minutes a week under quarter-hour rounding.
      Finishing 6 minutes late costs 30 minutes a week under quarter-hour rounding.
    </p>
    <p>
      That last habit, under quarter-hour rounding, is {lostMinutes / 60} hours over 50 working weeks. At $20 an hour it is {formatMoney(lostCents)}.
      Whether such a pattern is lawful depends on the facts, but it is the kind of result the "over a period of time" condition is about.
    </p>
  </section>

  <section>
    <h2>How to check your own pay</h2>
    <p>
      The <a href="/">time card calculator</a> has a Rounding setting: exact minutes, the nearest 5 minutes, the nearest 6 minutes (a tenth of an hour)
      or the nearest 15 minutes, which is the 7-minute rule. The card rounds every punch before it adds up the hours. With California rules selected,
      the meal-break notes always use the exact times you typed, because meal periods cannot be rounded there.
    </p>
    <ol>
      <li>For three or four weeks, write down the real times you clock in, clock out and take lunch.</li>
      <li>Enter a week in the time card calculator with Rounding set to <strong>Exact minutes</strong> and note the total.</li>
      <li>Change Rounding to your employer's system, such as <strong>Nearest 15 minutes</strong>, and note the new total.</li>
      <li>Compare. The gap is what rounding does to that week. Repeat for each week and add them up.</li>
      <li>Compare the rounded total with your pay stub. See <a href="/guides/check-your-paycheck-hours/">how to check the hours on your paycheck</a>.</li>
    </ol>
    <p>
      One week proves little, because rounding is meant to average out. A gap that is the same sign every week is worth raising.
    </p>
  </section>

  <section>
    <h2>If it keeps costing you</h2>
    <ul>
      <li>Ask payroll for the rounding policy in writing, and which system it uses.</li>
      <li>Share your comparison and ask how the policy averages out for you.</li>
      <li>In California, remember that meal period punches cannot be rounded.</li>
      <li>If it is not settled, your state labor office or the U.S. Department of Labor's Wage and Hour Division can explain the rules that apply.</li>
    </ul>
  </section>
</Guide>
