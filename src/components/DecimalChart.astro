---
import { formatDecimalHours } from '../engine/time';
import { roundMinutes } from '../engine/round';

const rows = Array.from({ length: 60 }, (_, i) => i + 1);
---

<div class="chart-columns">
<table class="chart" id="chart">
  <caption>Minutes to decimal hours, 1 to 60</caption>
  <thead>
    <tr>
      <th scope="col">Minutes</th>
      <th scope="col">Decimal hours</th>
      <th scope="col">3 places</th>
      <th scope="col">Nearest quarter hour</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((m) => (
        <tr id={`${m}-minutes`}>
          <th scope="row">
            <a href={`#${m}-minutes`}>{m}</a>
          </th>
          <td>{m} {m === 1 ? 'minute' : 'minutes'} = {formatDecimalHours(m)} hours</td>
          <td>{formatDecimalHours(m, 3)}</td>
          <td>{formatDecimalHours(roundMinutes(m, 15))}</td>
        </tr>
      ))
    }
  </tbody>
</table>
</div>
