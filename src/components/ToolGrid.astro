---
import { TOOLS } from '../site';

interface Props {
  /** Show only these tools. Leave out to show every other tool. */
  hrefs?: string[];
  heading?: string;
}

const { hrefs, heading = 'More tools' } = Astro.props;
const shown = TOOLS.map((tool, i) => ({ ...tool, no: String(i + 1).padStart(2, '0') })).filter(
  (tool) => tool.href !== Astro.url.pathname && (!hrefs || hrefs.includes(tool.href)),
);
---

<section class="tool-grid no-print" aria-labelledby="more-tools">
  <h2 id="more-tools">{heading}</h2>
  <ul>
    {
      shown.map((tool) => (
        <li>
          <span class="no" aria-hidden="true">{tool.no}</span>
          <a href={tool.href}>{tool.label}</a>
          <span class="sample">
            {tool.example} <strong>→ {tool.answer}</strong>
          </span>
          <p>{tool.blurb}</p>
        </li>
      ))
    }
  </ul>
</section>
