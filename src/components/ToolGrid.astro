---
import { TOOLS } from '../site';

interface Props {
  /** Show only these tools. Leave out to show every other tool. */
  hrefs?: string[];
  heading?: string;
}

const { hrefs, heading = 'More tools' } = Astro.props;
const shown = TOOLS.filter((tool) => tool.href !== Astro.url.pathname && (!hrefs || hrefs.includes(tool.href)));
---

<section class="tool-grid no-print" aria-labelledby="more-tools">
  <h2 id="more-tools">{heading}</h2>
  <ul>
    {
      shown.map((tool) => (
        <li>
          <a href={tool.href}>{tool.label}</a>
          <p>{tool.blurb}</p>
        </li>
      ))
    }
  </ul>
</section>
