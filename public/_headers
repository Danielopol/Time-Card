/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The embeddable widgets are meant to be framed by other sites.
/embed/converter/
  ! X-Frame-Options
/embed/converter/*
  ! X-Frame-Options
/embed/chart/
  ! X-Frame-Options
/embed/chart/*
  ! X-Frame-Options

# The chart PDFs are copies of the chart on each page. Point search engines at the page so the page ranks, not the file.
/military-time-chart.pdf
  Link: <https://hourstotal.com/military-time-converter/>; rel="canonical"
/decimal-hours-chart.pdf
  Link: <https://hourstotal.com/minutes-to-decimal/>; rel="canonical"
